{
  "env": {
    "node": true,
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "eqeqeq": ["warn", "always"],
    "curly": "warn",
    "no-var": "warn",
    "prefer-const": "warn"
  },
  "globals": {
    "SyncEngine": "readonly",
    "PeerRoom": "readonly",
    "YT": "readonly"
  }
}
