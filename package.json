{
  "name": "sumit-sh-sync-server",
  "version": "1.0.0",
  "description": "WebSocket sync server for jam.sync and watch.party",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --ext .js --ignore-pattern node_modules",
    "lint:fix": "eslint . --ext .js --ignore-pattern node_modules --fix",
    "test": "node --test tests/",
    "format": "prettier --write '**/*.{js,json,css,html}' --ignore-path .gitignore"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
